{
	"info": {
		"_postman_id": "master-backend-api-collection",
		"name": "Master Backend REST API",
		"description": "Complete API collection for the Master Backend with Authentication & RBAC Authorization.\n\nBase URL: http://localhost:5000\n\n**Setup:**\n1. Register or Login to get a JWT token.\n2. The token is automatically saved to the `authToken` collection variable.\n3. All protected routes use this token via Bearer Auth.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "",
			"type": "string"
		},
		{
			"key": "productId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "🏠 Root",
			"item": [
				{
					"name": "API Welcome / Directory",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": ["{{baseUrl}}"],
							"path": [""]
						},
						"description": "Returns a welcome message and the full API endpoint directory."
					},
					"response": []
				}
			]
		},
